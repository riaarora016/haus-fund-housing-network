# Published CSV URLs (Google Sheet → File → Share → Publish to web → choose tab → CSV). Dev falls back to ../data/properties.json.
VITE_PIPELINE_CSV_URL=
VITE_INVENTORY_CSV_URL=
# "false" builds the founder-only deployment (no /ops route, pipeline CSV never fetched). Default true.
VITE_ENABLE_OPS=true
# Apps Script web-app URL that handles the "I took a bed here" button (sheet/apps-script.gs). Falls back to a mailto.
VITE_RESIDENT_WEBHOOK_URL=
VITE_HOUSING_EMAIL=housing@biopunk.house
