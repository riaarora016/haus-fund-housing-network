# ---- Google Sheet (the DB) ----
SHEET_ID=                      # from the sheet URL: docs.google.com/spreadsheets/d/<SHEET_ID>/edit
GOOGLE_SERVICE_ACCOUNT_JSON=   # the whole service-account JSON on one line  (or set GOOGLE_APPLICATION_CREDENTIALS=./service-account.json)
# Published CSV URLs (File → Share → Publish to web → pick tab → CSV). Used by pull-from-sheet and the web app.
PIPELINE_CSV_URL=
INVENTORY_CSV_URL=

# ---- Claude API (reply parsing + changelog) ----
ANTHROPIC_API_KEY=

# ---- Gmail (housing@biopunk.house) — see README "Gmail API" ----
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_FROM=Biopunk Housing <housing@biopunk.house>
SENDER_NAME=Ria Arora
DIGEST_TO=riaarora016@gmail.com, elliot@biopunk.house

# ---- optional ----
GOOGLE_MAPS_API_KEY=           # not required; geocode.ts uses Nominatim
