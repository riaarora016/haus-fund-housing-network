{
  "name": "biopunk-housing",
  "version": "1.0.0",
  "description": "",
  "scripts": {
    "build": "tsx data/build.ts",
    "geocode": "tsx data/geocode.ts",
    "push-to-sheet": "tsx data/push-to-sheet.ts",
    "pull-from-sheet": "tsx data/pull-from-sheet.ts",
    "refresh:booking": "tsx refresh/scrape-booking.ts",
    "refresh:listings": "tsx refresh/scrape-listings.ts",
    "refresh:inbox": "tsx refresh/poll-inbox.ts",
    "refresh:normalize": "tsx refresh/normalize.ts",
    "refresh:digest": "tsx refresh/weekly-digest.ts",
    "refresh": "npm run refresh:booking && npm run refresh:listings && npm run refresh:inbox && npm run refresh:normalize",
    "typecheck": "tsc --noEmit",
    "web:dev": "npm --prefix web run dev",
    "web:build": "npm --prefix web run build",
    "export:xlsx": "tsx data/export-xlsx.ts && python3 data/style-xlsx.py",
    "export:map": "tsx data/export-map.ts",
    "build:map-artifact": "tsx data/export-map.ts && tsx data/build-map-artifact.ts",
    "build:inventory": "tsx data/export-inventory.ts && tsx data/build-inventory.ts && cp data/exports/haus-fund-housing-network.html web/public/"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/papaparse": "^5.5.2",
    "sharp": "^0.35.4",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "xlsx": "^0.18.5"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.120.0",
    "dotenv": "^17.4.2",
    "googleapis": "^176.0.0",
    "papaparse": "^5.6.0",
    "playwright": "^1.62.1",
    "zod": "^4.4.3"
  },
  "private": true
}
